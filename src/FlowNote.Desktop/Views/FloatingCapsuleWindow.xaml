<Window x:Class="FlowNote.Desktop.Views.FloatingCapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FlowNote.Desktop.Controls"
        Title="FlowNote 기록"
        Width="536"
        Height="68"
        MinWidth="80"
        MinHeight="68"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="1"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        FontFamily="Malgun Gothic, Segoe UI"
        Closing="OnClosing"
        Loaded="OnLoaded"
        LocationChanged="OnLocationChanged"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver"
        DragLeave="OnDragLeave"
        AutomationProperties.Name="FlowNote 기록 창">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowNote.Desktop;component/Themes/FloatingCapsule.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="RootHost">
        <StackPanel x:Name="LayoutStack" Margin="8">
            <controls:FloatingAuxiliaryPanel x:Name="PanelAbove"
                                             HorizontalAlignment="Right"
                                             Margin="0,0,0,6"
                                             Visibility="Collapsed"/>
                    <Border x:Name="CapsuleChrome"
                    Width="520" Height="52"
                    CornerRadius="26"
                    ClipToBounds="True"
                    BorderBrush="{StaticResource CapsuleBorderBrush}"
                    BorderThickness="1"
                    Background="{StaticResource CapsuleSurfaceBrush}"
                    MouseLeftButtonDown="OnCapsuleSurfaceDown">
                <Grid>
                    <controls:CapsuleInputBar x:Name="InputBar"
                                              LogoMenuRequested="OnLogoMenu"
                                              PasteImageRequested="OnPasteImage"/>
                    <Border Background="#33FFFFFF" CornerRadius="26" IsHitTestVisible="False"
                            Visibility="{Binding IsDraggingFiles, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
            <controls:FloatingAuxiliaryPanel x:Name="PanelBelow"
                                             HorizontalAlignment="Right"
                                             Margin="0,6,0,0"
                                             Visibility="Collapsed"/>
        </StackPanel>
        <Popup x:Name="LogoMenu"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=InputBar}"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{StaticResource CapsulePanelBrush}"
                    BorderBrush="{StaticResource CapsuleBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="6" MinWidth="180">
                <StackPanel>
                    <Button Style="{StaticResource CapsuleTextButton}" HorizontalAlignment="Stretch"
                            Content="하루의 흐름" Command="{Binding OpenTodayCommand}" Click="OnMenuCommand"/>
                    <Button Style="{StaticResource CapsuleTextButton}" HorizontalAlignment="Stretch"
                            Content="연결 업무 선택" Command="{Binding PickWorkCommand}" Click="OnMenuCommand"/>
                    <Button Style="{StaticResource CapsuleTextButton}" HorizontalAlignment="Stretch"
                            Content="연결 해제" Command="{Binding ClearWorkCommand}" Click="OnMenuCommand"/>
                    <Button Style="{StaticResource CapsuleTextButton}" HorizontalAlignment="Stretch"
                            Content="긴 메모" Command="{Binding OpenLongNoteCommand}" Click="OnMenuCommand"/>
                    <Button Style="{StaticResource CapsuleTextButton}" HorizontalAlignment="Stretch"
                            Content="{Binding AlwaysOnTopText}" Command="{Binding TogglePinCommand}" Click="OnMenuCommand"/>
                    <Button Style="{StaticResource CapsuleTextButton}" HorizontalAlignment="Stretch"
                            Content="숨기기" Command="{Binding HideCommand}" Click="OnMenuCommand"/>
                    <Button Style="{StaticResource CapsuleTextButton}" HorizontalAlignment="Stretch"
                            Content="저장 위치" Command="{Binding ShowStorageCommand}" Click="OnMenuCommand"/>
                    <Button Style="{StaticResource CapsuleTextButton}" HorizontalAlignment="Stretch"
                            Content="종료" Command="{Binding ExitCommand}" Click="OnMenuCommand"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>

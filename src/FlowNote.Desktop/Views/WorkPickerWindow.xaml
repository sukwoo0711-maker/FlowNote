<Window x:Class="FlowNote.Desktop.Views.WorkPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="연결 업무 선택"
        Width="420" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Malgun Gothic, Segoe UI">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="미완료 업무를 고르거나 새 업무를 만듭니다." TextWrapping="Wrap" Margin="0,0,0,12"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="취소" Click="OnCancel" MinWidth="80" Style="{StaticResource SecondaryButton}"/>
            <Button DockPanel.Dock="Right" Content="연결 해제" Click="OnUnlink" MinWidth="80" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="새 업무로 연결" Click="OnCreate" MinWidth="120"/>
            <TextBox x:Name="NewTitle" Margin="0,0,8,0" Height="36"/>
        </DockPanel>
        <ListBox x:Name="WorkList" DisplayMemberPath="Title" MouseDoubleClick="OnPick"/>
    </DockPanel>
</Window>

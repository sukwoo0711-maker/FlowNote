<Window x:Class="FlowNote.Desktop.Views.DayReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="하루 정리"
        Width="1100" Height="720"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Malgun Gothic, Segoe UI"
        FontSize="14">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="필터 해제"
                    Command="{Binding ClearFilterCommand}" Visibility="{Binding HasFilter, Converter={StaticResource BoolToVis}}"/>
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Header}"/>
                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding FilterText}"/>
                <TextBlock Margin="0,4,0,0" Text="{Binding SelectionSummary}"/>
            </StackPanel>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="패키지 저장" Command="{Binding SaveZipCommand}" MinWidth="110"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="텍스트 복사" Command="{Binding CopyCommand}" Margin="0,0,8,0" MinWidth="110"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="미리보기 만들기" Command="{Binding RefreshPreviewCommand}" Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" TextWrapping="Wrap"/>
        </DockPanel>
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="선택할 원문"/>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="추가" Command="{Binding AddOutOfRangeCommand}"/>
                    <TextBox Margin="0,0,8,0" Text="{Binding ExtraEntryId, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="다른 날짜 근거 ID"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="첨부는 기본 미포함. 본문을 고른 뒤 파일을 고릅니다."/>
                <ListBox ItemsSource="{Binding Rows}" Margin="0,8,8,8" BorderBrush="{StaticResource BorderBrushToken}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Content="{Binding Label}"
                                          Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}"/>
                                <ItemsControl ItemsSource="{Binding Files}" Margin="24,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      Content="{Binding Name}"
                                                      Command="{Binding DataContext.ToggleFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="미리보기"/>
                <TextBlock DockPanel.Dock="Top" Margin="0,4,0,0" Foreground="{StaticResource DangerBrush}"
                           Text="내용이 변경됐어요. 미리보기를 갱신하세요."
                           Visibility="{Binding ShowStale, Converter={StaticResource BoolToVis}}"/>
                <TextBox IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Text="{Binding PreviewText, Mode=OneWay}" Margin="0,8,0,0"
                         AcceptsReturn="True" FontFamily="Consolas, Malgun Gothic"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

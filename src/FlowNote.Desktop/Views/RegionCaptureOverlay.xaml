<Window x:Class="FlowNote.Desktop.Views.RegionCaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#44000000"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseLeftButtonDown="OnDown"
        MouseMove="OnMove"
        MouseLeftButtonUp="OnUp">
    <Canvas x:Name="Surface">
        <Border x:Name="Rubber"
                BorderBrush="#FF55CFC7"
                BorderThickness="1"
                Background="#2200A8A0"
                Visibility="Collapsed"/>
        <TextBlock Canvas.Left="24" Canvas.Top="24"
                   Foreground="#FFF2F6F8" FontSize="14"
                   Text="드래그해서 영역을 선택합니다. Esc는 취소입니다."/>
    </Canvas>
</Window>

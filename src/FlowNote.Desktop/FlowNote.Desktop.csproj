<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationTitle>FlowNote</ApplicationTitle>
    <RootNamespace>FlowNote.Desktop</RootNamespace>
    <AssemblyName>FlowNote.Desktop</AssemblyName>
    <ApplicationIcon>Assets\FlowNote.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\FlowNote.ico"/>
    <Resource Include="Assets\FlowNote.png"/>
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlowNote.Core\FlowNote.Core.csproj" />
    <ProjectReference Include="..\FlowNote.Infrastructure\FlowNote.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(FlowNotePublishProfile)' != 'Core'">
    <Content Include="..\..\packaging\ai-runtime\engine-lock.json"
             Link="ai-runtime\engine-lock.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\ai-runtime\model-lock.json"
             Link="ai-runtime\model-lock.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(FlowNotePublishProfile)' != 'SecurityPc' And '$(FlowNotePublishProfile)' != 'Core'">
    <Content Include="..\..\fixtures\v3\**\*"
             Link="fixtures\v3\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\fixtures\assist-v4\**\*"
             Link="fixtures\assist-v4\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

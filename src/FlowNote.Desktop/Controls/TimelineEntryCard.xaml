<UserControl x:Class="FlowNote.Desktop.Controls.TimelineEntryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FlowNote.Desktop.Controls"
             AutomationProperties.Name="타임라인 기록 카드">
    <controls:TimelineItemShell TimeLabel="{Binding TimeLabel}" NodeKind="note" Margin="0,0,0,12">
        <Border Padding="12" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsKeyboardFocusWithin}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel MaxWidth="720">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" MinHeight="28" Padding="8,2"
                            Content="{Binding WorkBadgeText}"
                            Command="{Binding DataContext.OpenWorkBadgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding ShowWorkBadge, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="연결 업무"/>
                    <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}"/>
                </DockPanel>
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding AssistBadgeText}"
                           Visibility="{Binding ShowAssistBadge, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Margin="0,4,0,0" FontSize="14" LineHeight="21" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Text="{Binding DisplayPreview}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPreview}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Image Margin="0,8,0,0" MaxWidth="320" MaxHeight="180" Stretch="Uniform" HorizontalAlignment="Left"
                       Source="{Binding HeroImagePath}"
                       Visibility="{Binding ShowHeroImage, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl Margin="0,8,0,-8" ItemsSource="{Binding FileTiles}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowFileTiles}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:AttachmentTile Width="200"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding OverflowText}" Visibility="{Binding ShowOverflow, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </controls:TimelineItemShell>
</UserControl>

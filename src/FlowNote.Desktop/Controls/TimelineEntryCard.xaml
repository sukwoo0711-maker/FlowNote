<UserControl x:Class="FlowNote.Desktop.Controls.TimelineEntryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FlowNote.Desktop.Controls"
             AutomationProperties.Name="타임라인 기록 카드">
    <controls:TimelineItemShell TimeLabel="{Binding TimeLabel}" NodeKind="note" Margin="0,0,0,12">
        <Border Padding="16" MaxWidth="520" HorizontalAlignment="Left">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFF9E8"/>
                    <Setter Property="CornerRadius" Value="3"/>
                    <Setter Property="BorderBrush" Value="#E6DDC6"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsKeyboardFocusWithin}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel MaxWidth="720">
                <controls:StickyNoteContent/>
                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding AssistBadgeText}" Visibility="{Binding ShowAssistBadge, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </controls:TimelineItemShell>
</UserControl>

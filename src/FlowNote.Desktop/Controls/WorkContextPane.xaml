<UserControl x:Class="FlowNote.Desktop.Controls.WorkContextPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="업무 맥락">
    <DockPanel>
        <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}"
                Content="닫기" Command="{Binding CloseDetailCommand}" AutomationProperties.Name="업무 맥락 닫기"/>
        <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ContextTitle}"/>
                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding ContextMeta}"/>
                <DockPanel Margin="0,16,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="수정"
                            Command="{Binding EditNextActionCommand}" MinHeight="32"
                            Visibility="{Binding ShowNextActionText, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="다음 행동"/>
                </DockPanel>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding ContextNextAction}"
                           Visibility="{Binding ShowNextActionText, Converter={StaticResource BoolToVis}}"/>
                <Button Margin="0,6,0,0" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Content="다음 행동 남기기" Command="{Binding EditNextActionCommand}"
                        Visibility="{Binding ShowNextActionEmpty, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="출처 기록을 지금은 열 수 없습니다."
                           Visibility="{Binding ContextSourceUnavailable, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowNextActionEditor, Converter={StaticResource BoolToVis}}">
                    <TextBox Text="{Binding NextActionDraft, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Height="36"
                             AutomationProperties.Name="다음 행동 입력"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding NextActionCount}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="저장" Command="{Binding SaveNextActionCommand}" MinWidth="72"/>
                        <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="취소" Command="{Binding CancelNextActionCommand}"/>
                        <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="지우기" Command="{Binding ClearNextActionCommand}"
                                Visibility="{Binding ShowNextActionText, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
                <Button Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Content="이전 다음 행동 사용" Command="{Binding RestoreNextActionCommand}"
                        Visibility="{Binding ShowRestoreNextAction, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Margin="0,20,0,0" FontWeight="SemiBold" Text="마지막 기록"/>
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding LatestNoteWhen}"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding LatestNotePreview}"/>
                <Button Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Content="원문 보기" Command="{Binding OpenLatestNoteCommand}"
                        Visibility="{Binding HasLatestNote, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Margin="0,20,0,0" FontWeight="SemiBold" Text="관련 자료"
                           Visibility="{Binding HasRelatedFiles, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding RelatedFileNames}" Margin="0,6,0,0"
                              Visibility="{Binding HasRelatedFiles, Converter={StaticResource BoolToVis}}"/>

                <DockPanel Margin="0,20,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="전체 흐름"
                            Command="{Binding OpenWorkFlowCommand}"/>
                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="최근 기록"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding RecentNoteLines}" Margin="0,6,0,0"/>
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="이 업무 전체 기록 · 현재 상태"/>

                <Button Margin="0,20,0,0" Content="이어서 기록" Command="{Binding ContinueRecordingCommand}"/>
                <Button Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" Content="보고에 담기" Command="{Binding AddToReportCommand}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="완료" Command="{Binding CompleteFromContextCommand}"/>
                    <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="다시 열기" Command="{Binding ReopenFromContextCommand}"/>
                    <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="취소" Command="{Binding CancelFromContextCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

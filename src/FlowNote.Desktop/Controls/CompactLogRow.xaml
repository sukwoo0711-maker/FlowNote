<UserControl x:Class="FlowNote.Desktop.Controls.CompactLogRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="148" Height="80" Margin="0,0,8,0">
    <Button Click="OnClick" Style="{StaticResource StickyPaperButton}"
            MinHeight="80" Padding="0" Cursor="Hand" AutomationProperties.Name="최근 포스트잇">
        <Border Style="{StaticResource StickyPaper}" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <Path x:Name="DoneMark" DockPanel.Dock="Right" Width="10" Height="10" Stretch="Uniform"
                          Fill="#3D7A5C" VerticalAlignment="Center" Visibility="Collapsed"
                          Data="M1,5 L4,8 L9,2"/>
                    <TextBlock Text="{Binding TimeLabel}" FontSize="10"
                               Foreground="#636366" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Grid.Row="1" Text="{Binding StickyText}" FontSize="12" LineHeight="16"
                           Foreground="#1C1C1E" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           Margin="0,4,0,0"/>
                <DockPanel Grid.Row="2" Margin="0,4,0,0">
                    <Image x:Name="Thumb" DockPanel.Dock="Right" Width="28" Height="18" Stretch="UniformToFill"
                           Visibility="Collapsed"/>
                    <TextBlock x:Name="FileLabel" FontSize="10" Foreground="#636366"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                </DockPanel>
            </Grid>
        </Border>
    </Button>
</UserControl>

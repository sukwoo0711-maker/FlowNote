<UserControl x:Class="FlowNote.Desktop.Controls.CompactLogRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="28">
    <Button Click="OnClick" Background="Transparent" BorderThickness="0"
            MinHeight="28" Padding="0" HorizontalContentAlignment="Stretch"
            Cursor="Hand" AutomationProperties.Name="최근 기록 행">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="4,0">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" FontSize="12"
                       Foreground="#FFB9CCD4" VerticalAlignment="Center"/>
            <Path x:Name="KindIcon" Grid.Column="1" Width="12" Height="12" Stretch="Uniform"
                  Fill="#FFD1E0E7" VerticalAlignment="Center" Data="M2,2 H10 V10 H2 Z"/>
            <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12"
                       Foreground="#FFF2F6F8" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Margin="6,0,6,0"/>
            <Image x:Name="Thumb" Grid.Column="3" Width="36" Height="22" Stretch="UniformToFill"
                   VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
    </Button>
</UserControl>

<UserControl x:Class="FlowNote.Desktop.Controls.CompactAttachmentRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="56" Margin="0,0,0,6">
    <Border Style="{StaticResource StickyPaper}" Padding="8">
        <DockPanel>
            <Button x:Name="RemoveButton"
                    DockPanel.Dock="Right"
                    Content="제거"
                    MinHeight="28" MinWidth="44" Padding="8,4"
                    Background="Transparent" Foreground="#1C1C1E"
                    BorderBrush="#E6DDC6" BorderThickness="1"
                    Click="OnRemove"
                    AutomationProperties.Name="첨부 제거"/>
            <Image x:Name="Thumb" Width="80" Height="56" Margin="0,0,8,0"
                   Stretch="UniformToFill" Visibility="Collapsed"/>
            <Path x:Name="FileGlyph" Width="18" Height="18" Margin="0,0,8,0" Stretch="Uniform"
                  Fill="#8A6A3D" VerticalAlignment="Center"
                  Data="M4,2 H12 L16,6 V18 H4 Z M12,2 V6 H16"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="NameText" FontSize="12" Foreground="#1C1C1E" TextWrapping="Wrap"/>
                <TextBlock x:Name="MetaText" FontSize="11" Foreground="#636366"/>
                <TextBlock x:Name="FailText" FontSize="11" Foreground="#B42318" Visibility="Collapsed"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>

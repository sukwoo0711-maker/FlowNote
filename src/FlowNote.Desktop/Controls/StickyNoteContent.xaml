<UserControl x:Class="FlowNote.Desktop.Controls.StickyNoteContent"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:FlowNote.Desktop.Controls"
 AutomationProperties.Name="포스트잇 본문">
 <StackPanel>
  <TextBlock Text="{Binding StickyText}" FontSize="15" FontWeight="Normal" LineHeight="24"
             Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
             Visibility="{Binding HasStickyText, Converter={StaticResource BoolToVis}}"/>
  <Image Source="{Binding HeroImagePath}" controls:ImagePreview.Path="{Binding HeroImagePath}"
         MaxWidth="420" MaxHeight="240" Margin="0,10,0,0" Stretch="Uniform" HorizontalAlignment="Left"
         Visibility="{Binding ShowHeroImage, Converter={StaticResource BoolToVis}}"/>
  <ItemsControl ItemsSource="{Binding FileTiles}" Margin="0,8,0,0"
                Visibility="{Binding ShowFileTiles, Converter={StaticResource BoolToVis}}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate><controls:AttachmentTile Width="200"/></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="{Binding OverflowText}" FontSize="12" Margin="0,4,0,0"
             Foreground="{StaticResource TextSecondaryBrush}"
             Visibility="{Binding ShowOverflow, Converter={StaticResource BoolToVis}}"/>
 </StackPanel>
</UserControl>

<UserControl x:Class="FlowNote.Desktop.Controls.CapsuleInputBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FlowNote.Desktop.Controls"
             Width="520" Height="52">
    <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="32"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="LogoButton"
                Grid.Column="0"
                Style="{StaticResource CapsuleIconButton}"
                Width="28" Height="32"
                Click="OnLogoClick"
                PreviewMouseLeftButtonDown="OnLogoDown"
                PreviewMouseMove="OnLogoMove"
                ToolTip="메뉴"
                AutomationProperties.Name="FlowNote 메뉴">
            <controls:LiveDots DotSize="6"/>
        </Button>

        <Grid Grid.Column="2" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource CapsuleTextButton}"
                    MaxWidth="88" Height="24" Margin="0,0,6,0"
                    Command="{Binding OpenLinkedWorkCommand}"
                    ToolTip="{Binding WorkChipToolTip}"
                    Visibility="{Binding ShowWorkChip, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="연결 업무">
                <TextBlock Text="{Binding WorkChipText}" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource CapsuleAccentBrush}"/>
            </Button>
            <Grid Grid.Column="1">
            <TextBox x:Name="Memo"
                     Style="{StaticResource CapsuleTextBox}"
                     Height="32"
                     MaxHeight="32"
                     Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="False"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Disabled"
                     HorizontalScrollBarVisibility="Hidden"
                     IsReadOnly="{Binding CapsuleInputReadOnly}"
                     Visibility="{Binding CapsuleInputReadOnly, Converter={StaticResource InverseBoolToVis}}"
                     PreviewKeyDown="OnMemoPreviewKeyDown"
                     TextChanged="OnMemoTextChanged"
                     DataObject.Pasting="OnMemoPasting"
                     AutomationProperties.Name="한 줄 메모"/>
            <TextBlock Text="{Binding SingleLineSummary}"
                       Foreground="{StaticResource CapsuleTextSecondaryBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Margin="4,0,0,0"
                       Visibility="{Binding CapsuleInputReadOnly, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding Placeholder}"
                       Foreground="{StaticResource CapsuleTextSecondaryBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0"
                       IsHitTestVisible="False"
                       Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding SuccessFlash}"
                       Foreground="{StaticResource CapsuleAccentBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0"
                       IsHitTestVisible="False"
                       Visibility="{Binding ShowSuccessFlash, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Grid>

        <Button Grid.Column="3"
                Style="{StaticResource CapsuleIconButton}"
                Command="{Binding SaveNoteCommand}"
                Visibility="{Binding ShowRecordButton, Converter={StaticResource BoolToHidden}}"
                ToolTip="기록"
                AutomationProperties.Name="기록">
            <Path Style="{StaticResource CommandIcon}"
                  Stroke="{StaticResource CapsuleAccentBrush}"
                  Fill="{x:Null}"
                  Data="{StaticResource IconSend}"/>
        </Button>

        <Button Grid.Column="5"
                Style="{StaticResource CapsuleIconButton}"
                Command="{Binding CaptureRegionCommand}"
                ToolTip="영역 캡처"
                AutomationProperties.Name="영역 캡처">
            <Path Style="{StaticResource CommandIcon}"
                  Stroke="{StaticResource CapsuleIconBrush}"
                  Fill="{x:Null}"
                  Data="{StaticResource IconCamera}"/>
        </Button>

        <Grid Grid.Column="6">
            <Button Style="{StaticResource CapsuleIconButton}"
                    Command="{Binding AttachCommand}"
                    ToolTip="첨부"
                    AutomationProperties.Name="첨부">
                <Path Style="{StaticResource CommandIcon}"
                      Stroke="{StaticResource CapsuleIconBrush}"
                      Fill="{x:Null}"
                      Data="{StaticResource IconClip}"/>
            </Button>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"
                    Background="{StaticResource CapsuleAccentBrush}" CornerRadius="6"
                    Padding="3,0" MinWidth="12"
                    Visibility="{Binding ShowAttachBadge, Converter={StaticResource BoolToVis}}"
                    IsHitTestVisible="False">
                <TextBlock Text="{Binding AttachBadgeText}" FontSize="9" Foreground="{StaticResource CapsuleBadgeTextBrush}"/>
            </Border>
        </Grid>

        <Grid Grid.Column="7">
            <Button Style="{StaticResource CapsuleTextButton}"
                    Width="64"
                    Command="{Binding ToggleTodoCommand}"
                    ToolTip="할 일"
                    AutomationProperties.Name="할 일">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource CommandIcon}" Width="16" Height="16"
                          Stroke="{StaticResource CapsuleIconBrush}"
                          Fill="{x:Null}"
                          Data="{StaticResource IconCheck}"/>
                    <TextBlock Grid.Column="1" Margin="4,0,0,0" Text="할 일"
                               Foreground="{StaticResource CapsuleTextPrimaryBrush}" FontSize="12"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"
                    Background="{StaticResource CapsuleAccentBrush}" CornerRadius="6"
                    Padding="3,0" MinWidth="12"
                    Visibility="{Binding ShowTodoBadge, Converter={StaticResource BoolToVis}}"
                    IsHitTestVisible="False">
                <TextBlock Text="{Binding TodoBadgeText}" FontSize="9" Foreground="{StaticResource CapsuleBadgeTextBrush}" HorizontalAlignment="Center"/>
            </Border>
        </Grid>

        <Button Grid.Column="8"
                Style="{StaticResource CapsuleIconButton}"
                Command="{Binding ToggleRecentCommand}"
                ToolTip="최근 기록"
                AutomationProperties.Name="최근 기록">
            <Path Style="{StaticResource CommandIcon}"
                  Stroke="{StaticResource CapsuleIconBrush}"
                  Fill="{x:Null}"
                  Data="{StaticResource IconClock}"/>
        </Button>
    </Grid>
</UserControl>

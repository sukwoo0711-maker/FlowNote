<UserControl x:Class="FlowNote.Desktop.Controls.TimelineEventRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FlowNote.Desktop.Controls"
             AutomationProperties.Name="타임라인 이벤트 행">
    <controls:TimelineItemShell TimeLabel="{Binding TimeLabel}" NodeKind="{Binding NodeKind}" Margin="0,0,0,12">
        <StackPanel Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="16" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="+"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeKind}" Value="completed">
                                    <Setter Property="Text" Value="✓"/>
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NodeKind}" Value="reopened">
                                    <Setter Property="Text" Value="↩"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NodeKind}" Value="cancelled">
                                    <Setter Property="Text" Value="×"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock FontSize="14" TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="{Binding KindLabel, Mode=OneWay}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding Title, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
            <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding TimeDetail}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowOccurredDifference}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </controls:TimelineItemShell>
</UserControl>

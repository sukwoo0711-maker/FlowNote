<UserControl x:Class="FlowNote.Desktop.Controls.TimelineItemShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Margin="0,8,8,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Right"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}"
                   Text="{Binding TimeLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <Grid Grid.Column="1">
            <Rectangle Width="1" Fill="{StaticResource BorderBrushToken}" HorizontalAlignment="Center"/>
            <Ellipse x:Name="Node" Width="8" Height="8" VerticalAlignment="Top" Margin="0,10,0,0"
                     HorizontalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                        <Setter Property="Stroke" Value="{StaticResource AccentBrush}"/>
                        <Setter Property="StrokeThickness" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NodeKind, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="created">
                                <Setter Property="Fill" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NodeKind, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="completed">
                                <Setter Property="Fill" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Stroke" Value="{StaticResource SuccessBrush}"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NodeKind, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="reopened">
                                <Setter Property="Fill" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NodeKind, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="cancelled">
                                <Setter Property="Fill" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </Grid>
        <ContentPresenter Grid.Column="2"
                          Content="{Binding Body, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </Grid>
</UserControl>

<UserControl x:Class="FlowNote.Desktop.Controls.WorkItemRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="40"
             AutomationProperties.Name="할 일 행">
    <DockPanel LastChildFill="True">
        <CheckBox x:Name="CompleteBox"
                  DockPanel.Dock="Left"
                  Width="32"
                  Height="32"
                  Margin="0,4,8,4"
                  VerticalAlignment="Top"
                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                  IsEnabled="{Binding IsIdle}"
                  Click="OnCheckClick"
                  AutomationProperties.Name="완료">
            <CheckBox.Template>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="32" Height="32" Background="Transparent">
                        <Border x:Name="Ring" Width="20" Height="20"
                                CornerRadius="10"
                                BorderBrush="{StaticResource TextSecondaryBrush}"
                                BorderThickness="1.5"
                                Background="{StaticResource SurfaceBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Path x:Name="Mark"
                                  Width="12" Height="12"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource SuccessBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M1,6 L4.5,9.5 L11,2"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Ring" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </CheckBox.Template>
        </CheckBox>
        <TextBlock VerticalAlignment="Center"
                   FontSize="14"
                   TextWrapping="Wrap"
                   MaxHeight="40"
                   Text="{Binding Title}"/>
    </DockPanel>
</UserControl>

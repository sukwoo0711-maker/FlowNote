<UserControl x:Class="FlowNote.Desktop.Controls.QuickCaptureComposer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FlowNote.Desktop.Controls"
             Padding="16"
             AutomationProperties.Name="빠른 기록">
    <StackPanel>
        <Grid>
            <Border Style="{StaticResource StickyPaper}">
                <Grid>
                    <TextBox x:Name="BodyBox"
                             MinHeight="96"
                             MaxHeight="160"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="12,10"
                             VerticalContentAlignment="Top"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource StickyInkBrush}"
                             CaretBrush="{StaticResource AccentBrush}"
                             Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="OnBodyChanged"
                             AutomationProperties.Name="메모 본문"/>
                    <TextBlock x:Name="Placeholder"
                               Margin="14,12,12,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               IsHitTestVisible="False"
                               Text="한 장에 적어도 됩니다"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Margin="0,8,0,0"
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="이미지 붙여넣기 · 파일 끌어놓기"/>
        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding PendingFiles}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPendingFiles}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:AttachmentTile MinWidth="240" MaxWidth="320" RemoveRequested="OnTileRemove"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource DangerBrush}" Text="{Binding ErrorText}" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <DockPanel Margin="0,12,0,0">
            <Button DockPanel.Dock="Right"
                    Content="{Binding SaveLabel}"
                    Command="{Binding SaveNoteCommand}"
                    AutomationProperties.Name="기록"/>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButton}"
                    Content="첨부"
                    Click="OnAttachClick"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding IsIdle}"
                    AutomationProperties.Name="첨부"/>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap"/>
        </DockPanel>
    </StackPanel>
</UserControl>

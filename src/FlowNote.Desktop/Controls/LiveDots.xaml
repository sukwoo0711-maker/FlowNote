<UserControl x:Class="FlowNote.Desktop.Controls.LiveDots"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="14"
             VerticalAlignment="Center"
             IsHitTestVisible="False"
             Focusable="False"
             AutomationProperties.Name="현재 진행 중">
    <StackPanel x:Name="Row" Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="Dot0" Width="6" Height="6" Margin="0,0,3,0"
                 Fill="{StaticResource LiveDotBrush}" Opacity="0.26"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Dot1" Width="6" Height="6" Margin="0,0,3,0"
                 Fill="{StaticResource LiveDotBrush}" Opacity="0.26"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Dot2" Width="6" Height="6"
                 Fill="{StaticResource LiveDotBrush}" Opacity="0.26"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
            </Ellipse.RenderTransform>
        </Ellipse>
    </StackPanel>
</UserControl>

<Window x:Class="FlowNote.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:FlowNote.Desktop.Controls"
        Title="FlowNote"
        Width="1280"
        Height="820"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Malgun Gothic, Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        Foreground="{StaticResource TextPrimaryBrush}"
        Icon="pack://application:,,,/Assets/FlowNote.png"
        SourceInitialized="OnSourceInitialized"
        SizeChanged="OnSizeChanged"
        StateChanged="OnStateChanged"
        PreviewKeyDown="OnPreviewKeyDown"
        AutomationProperties.Name="FlowNote 메인">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="-1"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ViewModeButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="ViewModeButtonOn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="12,10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNavRail}" Value="True">
                    <Setter Property="Padding" Value="0,10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="ToolTipService.Placement" Value="Right"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavButtonOn" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#66D4B896"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DayNavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NavGlyph" TargetType="Path" BasedOn="{StaticResource CommandIcon}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{x:Null}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNavRail}" Value="True">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Rectangle Fill="{StaticResource ShellWashBrush}" IsHitTestVisible="False"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource TitleBarFillBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <controls:LiveDots DotSize="6"/>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                   FontSize="13" Text="FlowNote"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="MinCaption" Style="{StaticResource CaptionMinButton}"
                                Click="OnMinimize" AutomationProperties.Name="최소화"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="MaxCaption" Style="{StaticResource CaptionMaxButton}"
                                Click="OnMaximize" AutomationProperties.Name="최대화"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="CloseCaption" Style="{StaticResource CaptionCloseButton}"
                                Click="OnCaptionClose" AutomationProperties.Name="창 닫기"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource GlassCardBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12"
                    Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Height="36" Content="확인"
                            Command="{Binding DismissOnboardingCommand}" MinWidth="72"
                            AutomationProperties.Name="첫 실행 안내 닫기"/>
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                               Text="메모와 첨부파일은 이 PC의 로컬 폴더에 저장됩니다. 앱 자체 암호화는 없습니다. Windows 로그인 시 시작은 꺼져 있습니다. 기록 창은 기본적으로 다른 창 위에 둡니다."/>
                </DockPanel>
            </Border>

            <Grid x:Name="ShellGrid" Grid.Row="2" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavColumn" Width="220"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="DetailColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource GlassCard}">
                            <Setter Property="Padding" Value="14,20"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavRail}" Value="True">
                                    <Setter Property="Padding" Value="6,16"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button x:Name="SettingsNavButton" DockPanel.Dock="Bottom" Style="{StaticResource NavButton}"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip="설정"
                                AutomationProperties.Name="설정">
                            <Grid>
                                <Path Style="{StaticResource NavGlyph}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="{StaticResource IconGear}"/>
                                <TextBlock Margin="28,0,0,0" VerticalAlignment="Center" Text="설정"
                                           Visibility="{Binding IsNavRail, Converter={StaticResource InverseBoolToVis}}"/>
                            </Grid>
                        </Button>
                        <StackPanel>
                            <Border Margin="0,0,0,16" Padding="10,8" CornerRadius="14"
                                    Background="#59FFFFFF" BorderBrush="#66D4B896" BorderThickness="1"
                                    Visibility="{Binding IsNavRail, Converter={StaticResource InverseBoolToVis}}">
                                <DockPanel LastChildFill="True">
                                    <controls:LiveDots DockPanel.Dock="Left" DotSize="6" IsAnimating="False" VerticalAlignment="Center"/>
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="하루 기록"/>
                                </DockPanel>
                            </Border>
                            <controls:LiveDots HorizontalAlignment="Center" DotSize="6" IsAnimating="False"
                                               Margin="0,0,0,14"
                                               Visibility="{Binding IsNavRail, Converter={StaticResource BoolToVis}}"/>
                            <Button x:Name="FlowNavButton" Style="{StaticResource NavButton}" Command="{Binding OpenFlowCommand}"
                                    ToolTip="하루의 흐름"
                                    AutomationProperties.Name="하루의 흐름">
                                <Grid>
                                    <Path Style="{StaticResource NavGlyph}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource IconCalendar}"/>
                                    <TextBlock Margin="28,0,0,0" VerticalAlignment="Center" Text="하루의 흐름"
                                               Visibility="{Binding IsNavRail, Converter={StaticResource InverseBoolToVis}}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="TodosNavButton" Style="{StaticResource NavButton}" Command="{Binding OpenTodosCommand}"
                                    ToolTip="할 일"
                                    AutomationProperties.Name="할 일">
                                <Grid>
                                    <Path Style="{StaticResource NavGlyph}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource IconCheck}"/>
                                    <TextBlock Margin="28,0,0,0" VerticalAlignment="Center" Text="할 일"
                                               Visibility="{Binding IsNavRail, Converter={StaticResource InverseBoolToVis}}"/>
                                </Grid>
                            </Button>
                            <Grid Margin="0,14,0,0" Visibility="{Binding IsNavRail, Converter={StaticResource InverseBoolToVis}}">
                                <TextBox Height="36" Padding="34,8,52,8"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="검색어">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Path Style="{StaticResource NavGlyph}" Width="16" Height="16"
                                      Margin="12,0,0,0" HorizontalAlignment="Left"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      Data="{StaticResource IconSearch}"
                                      IsHitTestVisible="False"/>
                                <TextBlock Margin="34,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13" IsHitTestVisible="False" Text="기록 검색">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,4,0"
                                        MinHeight="28" Command="{Binding SearchCommand}"
                                        AutomationProperties.Name="찾기">
                                    <TextBlock FontSize="12" Text="찾기"/>
                                </Button>
                            </Grid>
                            <Button Style="{StaticResource NavButton}" Command="{Binding SearchCommand}"
                                    Margin="0,4,0,0" ToolTip="찾기"
                                    Visibility="{Binding IsNavRail, Converter={StaticResource BoolToVis}}"
                                    AutomationProperties.Name="찾기">
                                <Path Style="{StaticResource NavGlyph}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="{StaticResource IconSearch}"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="2">
                    <Grid Visibility="{Binding IsFlow, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource GlassCard}" Padding="22,20" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" VerticalAlignment="Top" Height="36" Content="하루 정리"
                                            Command="{Binding OpenDayReportCommand}"
                                            MinWidth="96" AutomationProperties.Name="하루 정리"/>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding HeaderTitle}"/>
                                        <TextBlock Margin="0,4,0,0" FontSize="26" FontWeight="SemiBold"
                                                   Text="{Binding DateHeading}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,16,0,0" LastChildFill="False">
                                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"
                                            Content="{Binding ContinueLabel}"
                                            Command="{Binding ToggleContinueCommand}" AutomationProperties.Name="이어서 할 일"/>
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource DayNavButton}" Command="{Binding PreviousDayCommand}"
                                                AutomationProperties.Name="이전 날" ToolTip="이전 날">
                                            <Path Style="{StaticResource CommandIcon}" Width="16" Height="16"
                                                  Stroke="{StaticResource AccentBrush}" Fill="{x:Null}"
                                                  Data="{StaticResource IconChevronLeft}"/>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Content="오늘" Margin="8,0"
                                                Command="{Binding TodayCommand}" AutomationProperties.Name="오늘"/>
                                        <Button Style="{StaticResource DayNavButton}" Command="{Binding NextDayCommand}"
                                                AutomationProperties.Name="다음 날" ToolTip="다음 날">
                                            <Path Style="{StaticResource CommandIcon}" Width="16" Height="16"
                                                  Stroke="{StaticResource AccentBrush}" Fill="{x:Null}"
                                                  Data="{StaticResource IconChevronRight}"/>
                                        </Button>
                                        <Border Margin="16,0,0,0" VerticalAlignment="Center"
                                                Background="#59FFFFFF" BorderBrush="#66D4B896" BorderThickness="1"
                                                CornerRadius="16" Padding="3">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="ChronologicalButton" Style="{StaticResource ViewModeButtonOn}" Content="시간순" Command="{Binding ChronologicalCommand}" Click="OnViewModeClick" AutomationProperties.Name="시간순 보기"/>
                                                <Button x:Name="PanoramaButton" Style="{StaticResource ViewModeButton}" Content="파노라마" Command="{Binding PanoramaCommand}" Click="OnViewModeClick" AutomationProperties.Name="파노라마 보기"/>
                                                <Button x:Name="ByWorkButton" Style="{StaticResource ViewModeButton}" Content="업무별" Command="{Binding ByWorkCommand}" Click="OnViewModeClick" AutomationProperties.Name="업무별 보기"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Margin="0,12,0,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding SummaryText}"/>
                                <StackPanel Visibility="{Binding HasMinimap, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding MinimapLegend}"/>
                                    <ItemsControl ItemsSource="{Binding MinimapLanes}" Margin="0,6,0,0" MaxHeight="80"
                                                  AutomationProperties.Name="업무 연결 미니맵">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Left" Width="88" TextWrapping="Wrap" FontSize="12"
                                                               VerticalAlignment="Center" Text="{Binding Title}"/>
                                                    <ItemsControl ItemsSource="{Binding Nodes}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel VerticalAlignment="Center"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                                                    <TextBlock FontSize="12" Text="{Binding Marker}"/>
                                                                    <TextBlock Margin="4,0,0,0" FontSize="12" Text="{Binding Text}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="16">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                                    <controls:LiveDots DotSize="10" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Text="{Binding EmptyPrimary}"/>
                                    <Button Margin="0,12,0,0" Content="첫 기록 남기기" Command="{Binding FirstRecordCommand}"/>
                                    <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="샘플 하루는 데모 저장소(--demo)에서만 생성합니다."
                                               TextWrapping="Wrap" Width="280" TextAlignment="Center"/>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Margin="32"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding PanoramaHint}"
                                           Visibility="{Binding ShowPanoramaHint, Converter={StaticResource BoolToVis}}"/>
                                <DockPanel Visibility="{Binding ShowPanorama, Converter={StaticResource BoolToVis}}">
                                    <StackPanel DockPanel.Dock="Top" Margin="4,0,4,12">
                                        <TextBlock FontSize="16" FontWeight="SemiBold"
                                                   Text="{Binding PanoramaSummary}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding ShowPanoramaSummary, Converter={StaticResource BoolToVis}}"
                                                   AutomationProperties.Name="오늘 업무 순서"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="관측된 기록 범위 · 실작업시간 아님"/>
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  AutomationProperties.Name="업무 구간 목록">
                                        <ItemsControl ItemsSource="{Binding PanoramaSegments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,10">
                                                        <TextBlock Margin="8,0,0,6" FontSize="12"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="같은 업무로 돌아옴"
                                                                   Visibility="{Binding ShowsSameWorkReturn, Converter={StaticResource BoolToVis}}"/>
                                                        <Border CornerRadius="14" Padding="0" BorderThickness="1"
                                                                BorderBrush="{StaticResource HairlineBrush}"
                                                                Background="{StaticResource GlassCardBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AccentIndex}" Value="1">
                                                                            <Setter Property="BorderBrush" Value="#3D6A5A"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding AccentIndex}" Value="2">
                                                                            <Setter Property="BorderBrush" Value="#6A4A6A"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding AccentIndex}" Value="3">
                                                                            <Setter Property="BorderBrush" Value="#4A5A7A"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding AccentIndex}" Value="4">
                                                                            <Setter Property="BorderBrush" Value="#8A5A3D"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding AccentIndex}" Value="5">
                                                                            <Setter Property="BorderBrush" Value="#5A6A3D"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Left" Width="6" CornerRadius="14,0,0,14">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsRequest}" Value="True">
                                                                                    <Setter Property="Background" Value="#C4A574"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsUnclassified}" Value="True">
                                                                                    <Setter Property="Background" Value="#8A8680"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                                <StackPanel Margin="12,10,12,10">
                                                                    <Button Command="{Binding DataContext.TogglePanoramaSegmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            HorizontalContentAlignment="Stretch"
                                                                            Cursor="Hand"
                                                                            AutomationProperties.Name="구간 펼치기">
                                                                        <StackPanel>
                                                                            <DockPanel>
                                                                                <TextBlock DockPanel.Dock="Right" FontSize="12"
                                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                                           Text="{Binding TimeLabel}"/>
                                                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap"/>
                                                                            </DockPanel>
                                                                            <TextBlock Margin="0,4,0,0" FontSize="12"
                                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                                       Text="{Binding CountLabel}"/>
                                                                            <TextBlock Margin="0,2,0,0" FontSize="12"
                                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                                       Text="{Binding StatusLabel}"
                                                                                       Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVis}}"/>
                                                                            <TextBlock Margin="0,4,0,0" FontSize="12"
                                                                                       Text="중간 요청 · 수행 흐름을 끊지 않음"
                                                                                       Visibility="{Binding IsRequest, Converter={StaticResource BoolToVis}}"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <TextBlock Margin="0,6,0,0" FontSize="12"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               Text="···· 기록 사이 추정 연결"
                                                                               Visibility="{Binding HasObservationGap, Converter={StaticResource BoolToVis}}"/>
                                                                    <ItemsControl ItemsSource="{Binding Notes}"
                                                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Button Margin="0,8,0,0"
                                                                                        Command="{Binding DataContext.OpenPanoramaNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Background="Transparent"
                                                                                        BorderThickness="0"
                                                                                        HorizontalContentAlignment="Stretch"
                                                                                        Cursor="Hand"
                                                                                        AutomationProperties.Name="원문 열기">
                                                                                    <DockPanel>
                                                                                        <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" Text="●"/>
                                                                                        <TextBlock DockPanel.Dock="Right" FontSize="12"
                                                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                                                   Text="{Binding TimeLabel}"/>
                                                                                        <TextBlock Text="{Binding DisplayPreview}" TextWrapping="Wrap"/>
                                                                                    </DockPanel>
                                                                                </Button>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                                <ListBox x:Name="TimelineList"
                                         ItemsSource="{Binding Rows}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         SelectionChanged="OnTimelineSelectionChanged"
                                         ItemTemplateSelector="{StaticResource TimelineRowSelector}"
                                         AutomationProperties.Name="하루 타임라인">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ShowTimeline}" Value="True"/>
                                                        <Condition Binding="{Binding ShowDetailOverlay}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <Border Background="{StaticResource GlassCardBrush}" CornerRadius="16" Padding="16"
                                        Visibility="{Binding ShowDetailOverlay, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <controls:EntryDetailPane Visibility="{Binding ShowEntryDetail, Converter={StaticResource BoolToVis}}"/>
                                        <controls:WorkContextPane Visibility="{Binding ShowWorkContext, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <DockPanel Visibility="{Binding IsTodosPage, Converter={StaticResource BoolToVis}}">
                        <Border DockPanel.Dock="Top" Style="{StaticResource GlassCard}" Padding="20,16" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <controls:LiveDots DotSize="7" IsAnimating="False" VerticalAlignment="Center"/>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="26" FontWeight="SemiBold" Text="할 일"/>
                            </StackPanel>
                        </Border>
                        <ListBox ItemsSource="{Binding AllOpenWork}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                            Command="{Binding DataContext.OpenContinueWorkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding WorkItem.Title}"/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding WorkItem.NextActionText, TargetNullValue=다음 행동 미등록}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <StackPanel Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock FontSize="26" FontWeight="SemiBold" Text="설정"/>
                                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding SettingsMode}"/>
                                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Text="{Binding SettingsPath}"/>
                                <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                                        Content="저장 폴더 열기" Command="{Binding OpenStorageFolderCommand}"
                                        AutomationProperties.Name="저장 폴더 열기"/>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding CaptureHotkeyText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RaisedGlass}" Padding="18" MaxWidth="640" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="로컬 보조"/>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding AssistModeText}"/>
                                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Text="{Binding AssistModelText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource SecondaryButton}" Content="끔" Command="{Binding SetAssistOffCommand}"
                                            AutomationProperties.Name="보조 끔"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="규칙만" Command="{Binding SetAssistRulesCommand}"
                                            Margin="8,0,0,0" AutomationProperties.Name="규칙만"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="로컬 보조" Command="{Binding SetAssistLocalCommand}"
                                            Margin="8,0,0,0" AutomationProperties.Name="로컬 보조"/>
                                </StackPanel>
                                <TextBlock Margin="0,16,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Text="기본은 규칙 연결입니다. 같은 업무를 이을 때만 쓰고, 로컬 보조만 동봉 엔진을 켭니다. 가격·결제·외부 AI·자동 수집은 없습니다."/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource SecondaryButton}" Content="모델 파일 가져오기" Command="{Binding ImportModelCommand}"
                                            AutomationProperties.Name="모델 파일 가져오기"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="다시 시도" Command="{Binding RetryEngineCommand}"
                                            Margin="8,0,0,0" AutomationProperties.Name="엔진 다시 시도"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="AI 없이 계속" Command="{Binding ContinueWithoutAiCommand}"
                                            Margin="8,0,0,0" AutomationProperties.Name="AI 없이 계속"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="3"
                        Style="{StaticResource GlassCard}"
                        Padding="16"
                        Margin="12,0,0,0"
                        Visibility="{Binding ShowDetailColumn, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <controls:EntryDetailPane Visibility="{Binding ShowEntryDetail, Converter={StaticResource BoolToVis}}"/>
                        <controls:WorkContextPane Visibility="{Binding ShowWorkContext, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Popup IsOpen="{Binding ShowContinuePopup}" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource GlassCardBrush}" BorderBrush="#73FFFFFF"
                    BorderThickness="1" CornerRadius="16" Padding="12" MinWidth="280">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="할 일"/>
                    <ItemsControl ItemsSource="{Binding ContinuePreview}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                        Command="{Binding DataContext.OpenContinueWorkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding WorkItem.Title}" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding WorkItem.NextActionText, TargetNullValue=다음 행동 미등록}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource SecondaryButton}" Content="전체 할 일" Command="{Binding OpenTodosCommand}"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>

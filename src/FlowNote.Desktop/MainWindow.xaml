<Window x:Class="FlowNote.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FlowNote.Desktop.Controls"
        Title="FlowNote"
        Width="1280"
        Height="820"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Malgun Gothic, Segoe UI"
        FontSize="14"
        Foreground="{StaticResource TextPrimaryBrush}"
        SourceInitialized="OnSourceInitialized"
        SizeChanged="OnSizeChanged"
        PreviewKeyDown="OnPreviewKeyDown"
        AutomationProperties.Name="FlowNote 메인">
    <Window.Resources>
        <Style x:Key="ViewModeButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="ViewModeButtonOn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="{StaticResource AccentSoftBrush}"
                BorderBrush="{StaticResource BorderBrushToken}"
                BorderThickness="0,0,0,1"
                Padding="16,12"
                Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="확인" Command="{Binding DismissOnboardingCommand}" MinWidth="72"
                        AutomationProperties.Name="첫 실행 안내 닫기"/>
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                           Text="메모와 첨부파일은 이 PC의 로컬 폴더에 저장됩니다. 앱 자체 암호화는 없습니다. Windows 로그인 시 시작은 꺼져 있습니다. 기록 창은 기본적으로 다른 창 위에 둡니다."/>
            </DockPanel>
        </Border>
        <Grid x:Name="ShellGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="168"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DetailColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushToken}"
                    BorderThickness="0,0,1,0"
                    Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Style="{StaticResource NavButton}" Content="설정" Command="{Binding OpenSettingsCommand}"
                                AutomationProperties.Name="설정"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="FlowNote" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,4,0,16" Foreground="{StaticResource TextSecondaryBrush}" Text="하루의 흐름"/>
                        <Button Style="{StaticResource NavButton}" Content="하루의 흐름" Command="{Binding OpenFlowCommand}" AutomationProperties.Name="하루의 흐름"/>
                        <Button Style="{StaticResource NavButton}" Content="할 일" Command="{Binding OpenTodosCommand}" AutomationProperties.Name="할 일"/>
                        <TextBlock Margin="0,8,0,8" Foreground="{StaticResource TextSecondaryBrush}" Text="검색"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="36"
                                 AutomationProperties.Name="검색어"/>
                        <Button Style="{StaticResource NavButton}" Content="찾기" Command="{Binding SearchCommand}" Margin="0,8,0,0" AutomationProperties.Name="찾기"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="24,16,24,16">
                <Grid Visibility="{Binding IsFlow, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="하루 정리" Command="{Binding OpenDayReportCommand}"
                                MinWidth="96" AutomationProperties.Name="하루 정리"/>
                        <StackPanel>
                            <TextBlock Text="{Binding HeaderTitle}" FontSize="22" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                                <Button Style="{StaticResource SecondaryButton}" Content="이전" Command="{Binding PreviousDayCommand}" AutomationProperties.Name="이전 날"/>
                                <TextBlock Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding DateLabel}"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="다음" Command="{Binding NextDayCommand}" AutomationProperties.Name="다음 날"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="오늘" Command="{Binding TodayCommand}" Margin="8,0,0,0" AutomationProperties.Name="오늘"/>
                            </StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{Binding ContinueLabel}"
                                        Command="{Binding ToggleContinueCommand}" AutomationProperties.Name="이어서 할 일"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ChronologicalButton" Style="{StaticResource ViewModeButtonOn}" Content="시간순" Command="{Binding ChronologicalCommand}" Click="OnViewModeClick" AutomationProperties.Name="시간순 보기"/>
                                    <Button x:Name="PanoramaButton" Style="{StaticResource ViewModeButton}" Content="파노라마" Command="{Binding PanoramaCommand}" Click="OnViewModeClick" AutomationProperties.Name="파노라마 보기"/>
                                    <Button x:Name="ByWorkButton" Style="{StaticResource ViewModeButton}" Content="업무별" Command="{Binding ByWorkCommand}" Click="OnViewModeClick" AutomationProperties.Name="업무별 보기"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding SummaryText}"/>
                            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding MinimapLegend}"/>
                            <ItemsControl ItemsSource="{Binding MinimapLanes}" Margin="0,6,0,0" MaxHeight="112"
                                          AutomationProperties.Name="업무 연결 미니맵">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left" Width="88" TextWrapping="Wrap" FontSize="12"
                                                       VerticalAlignment="Center" Text="{Binding Title}"/>
                                            <ItemsControl ItemsSource="{Binding Nodes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel VerticalAlignment="Center"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                                            <TextBlock FontSize="12" Text="{Binding Marker}"/>
                                                            <TextBlock Margin="4,0,0,0" FontSize="12" Text="{Binding Text}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,12,0,0" MaxWidth="800" HorizontalAlignment="Left">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Text="{Binding EmptyPrimary}"/>
                            <Button Margin="0,12,0,0" Content="첫 기록 남기기" Command="{Binding FirstRecordCommand}"/>
                            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="샘플 하루는 데모 저장소(--demo)에서만 생성합니다."
                                       TextWrapping="Wrap" Width="280" TextAlignment="Center"/>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="32"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding PanoramaHint}"
                                   Visibility="{Binding IsPanorama, Converter={StaticResource BoolToVis}}"/>
                        <ListBox x:Name="TimelineList"
                                 ItemsSource="{Binding Rows}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 SelectionChanged="OnTimelineSelectionChanged"
                                 ItemTemplateSelector="{StaticResource TimelineRowSelector}"
                                 AutomationProperties.Name="하루 타임라인">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowTimeline}" Value="True"/>
                                                <Condition Binding="{Binding ShowDetailOverlay}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <Border Background="{StaticResource SurfaceBrush}" Padding="16"
                                Visibility="{Binding ShowDetailOverlay, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <controls:EntryDetailPane Visibility="{Binding ShowEntryDetail, Converter={StaticResource BoolToVis}}"/>
                                <controls:WorkContextPane Visibility="{Binding ShowWorkContext, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <DockPanel Visibility="{Binding IsTodosPage, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Top" FontSize="22" FontWeight="SemiBold" Text="현재 진행 중"/>
                    <ListBox ItemsSource="{Binding AllOpenWork}" BorderThickness="0" Background="Transparent" Margin="0,16,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                        Command="{Binding DataContext.OpenContinueWorkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel HorizontalAlignment="Left">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding WorkItem.Title}"/>
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding WorkItem.NextActionText, TargetNullValue=다음 행동 미등록}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <StackPanel Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="설정"/>
                    <TextBlock Margin="0,12,0,0" Text="{Binding SettingsMode}"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding SettingsPath}"/>
                    <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="로컬 보조"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding AssistModeText}"/>
                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Text="{Binding AssistModelText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="끔" Command="{Binding SetAssistOffCommand}"
                                AutomationProperties.Name="보조 끔"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="규칙만" Command="{Binding SetAssistRulesCommand}"
                                Margin="8,0,0,0" AutomationProperties.Name="규칙만"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="로컬 보조" Command="{Binding SetAssistLocalCommand}"
                                Margin="8,0,0,0" AutomationProperties.Name="로컬 보조"/>
                    </StackPanel>
                    <TextBlock Margin="0,16,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Text="기록 창 고정과 패널 유지는 캡슐 메뉴에서 바꿉니다. 가격·결제·외부 AI·자동 수집 설정은 없습니다. 포트와 API 키는 앱이 관리합니다."/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="모델 파일 가져오기" Command="{Binding ImportModelCommand}"
                                AutomationProperties.Name="모델 파일 가져오기"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="다시 시도" Command="{Binding RetryEngineCommand}"
                                Margin="8,0,0,0" AutomationProperties.Name="엔진 다시 시도"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="AI 없이 계속" Command="{Binding ContinueWithoutAiCommand}"
                                Margin="8,0,0,0" AutomationProperties.Name="AI 없이 계속"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushToken}"
                    BorderThickness="1,0,0,0"
                    Padding="16"
                    Visibility="{Binding ShowDetailColumn, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <controls:EntryDetailPane Visibility="{Binding ShowEntryDetail, Converter={StaticResource BoolToVis}}"/>
                    <controls:WorkContextPane Visibility="{Binding ShowWorkContext, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </Grid>

        <Popup IsOpen="{Binding ShowContinuePopup}" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushToken}"
                    BorderThickness="1" CornerRadius="12" Padding="12" MinWidth="280">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="현재 진행 중"/>
                    <ItemsControl ItemsSource="{Binding ContinuePreview}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                        Command="{Binding DataContext.OpenContinueWorkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding WorkItem.Title}" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding WorkItem.NextActionText, TargetNullValue=다음 행동 미등록}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource SecondaryButton}" Content="전체 할 일" Command="{Binding OpenTodosCommand}"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brand.xaml"/>
        <ResourceDictionary Source="CommandIcons.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Color x:Key="CapsuleTintStartColor">#E61C2226</Color>
    <Color x:Key="CapsuleTintEndColor">#F214181A</Color>
    <SolidColorBrush x:Key="CapsulePanelBrush" Color="#F21A2024"/>
    <SolidColorBrush x:Key="CapsuleOpaqueBrush" Color="#FF151A1C"/>
    <SolidColorBrush x:Key="CapsuleBorderBrush" Color="#80D4B896"/>
    <SolidColorBrush x:Key="CapsuleHighlightBrush" Color="#73FFFFFF"/>
    <SolidColorBrush x:Key="CapsuleTextPrimaryBrush" Color="#FFF6F1E8"/>
    <SolidColorBrush x:Key="CapsuleTextSecondaryBrush" Color="#FFC9BBA6"/>
    <SolidColorBrush x:Key="CapsuleIconBrush" Color="#FFE6D7C0"/>
    <SolidColorBrush x:Key="CapsuleAccentBrush" Color="#FFD4B896"/>
    <SolidColorBrush x:Key="CapsuleCompletedBrush" Color="#FF75D5B0"/>
    <SolidColorBrush x:Key="CapsuleErrorBrush" Color="#FFFFB4AB"/>
    <SolidColorBrush x:Key="CapsuleHoverBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="CapsulePressedBrush" Color="#33FFFFFF"/>

    <LinearGradientBrush x:Key="CapsuleSurfaceBrush" StartPoint="0.1,0" EndPoint="0.9,1">
        <GradientStop Color="#F02C343A" Offset="0"/>
        <GradientStop Color="#E622282C" Offset="0.42"/>
        <GradientStop Color="{StaticResource CapsuleTintEndColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CapsuleSheenBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#14FFFFFF" Offset="0.45"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="CapsuleIconButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource CapsuleIconBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{StaticResource CapsuleAccentBrush}"
                            BorderThickness="0"
                            RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CapsuleHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#40D4B896"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CapsulePressedBrush}"/>
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CapsuleTextButton" TargetType="Button" BasedOn="{StaticResource CapsuleIconButton}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Foreground" Value="{StaticResource CapsuleTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Malgun Gothic, Segoe UI Variable Text, Segoe UI"/>
    </Style>

    <Style x:Key="CapsuleTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource CapsuleTextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource CapsuleAccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource CapsuleAccentBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Malgun Gothic, Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CapsuleAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

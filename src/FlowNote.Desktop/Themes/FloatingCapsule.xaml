<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brand.xaml"/>
        <ResourceDictionary Source="CommandIcons.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="CapsulePanelBrush" Color="#EDE8E1"/>
    <SolidColorBrush x:Key="CapsuleOpaqueBrush" Color="#FFF9E8"/>
    <SolidColorBrush x:Key="CapsuleBorderBrush" Color="#E6DDC6"/>
    <SolidColorBrush x:Key="CapsuleHighlightBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="CapsuleTextPrimaryBrush" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="CapsuleTextSecondaryBrush" Color="#636366"/>
    <SolidColorBrush x:Key="CapsuleIconBrush" Color="#8A6A3D"/>
    <SolidColorBrush x:Key="CapsuleAccentBrush" Color="#8A6A3D"/>
    <SolidColorBrush x:Key="CapsuleCompletedBrush" Color="#3D7A5C"/>
    <SolidColorBrush x:Key="CapsuleErrorBrush" Color="#B42318"/>
    <SolidColorBrush x:Key="StickyPaperBrush" Color="#FFF9E8"/>
    <SolidColorBrush x:Key="StickyEdgeBrush" Color="#E6DDC6"/>
    <SolidColorBrush x:Key="StickyInkBrush" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="CapsuleHoverBrush" Color="#141C1C1E"/>
    <SolidColorBrush x:Key="CapsulePressedBrush" Color="#261C1C1E"/>
    <SolidColorBrush x:Key="CapsuleSurfaceBrush" Color="#FFF9E8"/>
    <SolidColorBrush x:Key="CapsuleSheenBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="CapsuleBadgeTextBrush" Color="#FFF9E8"/>

    <Style x:Key="CapsuleIconButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource CapsuleIconBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{StaticResource CapsuleAccentBrush}"
                            BorderThickness="0"
                            RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CapsuleHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CapsulePressedBrush}"/>
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CapsuleTextButton" TargetType="Button" BasedOn="{StaticResource CapsuleIconButton}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Foreground" Value="{StaticResource CapsuleTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Malgun Gothic, Segoe UI Variable Text, Segoe UI"/>
    </Style>

    <Style x:Key="StickyPaper" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StickyPaperBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StickyEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="StickyPaperButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CapsuleTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource CapsuleTextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource CapsuleAccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource CapsuleAccentBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Malgun Gothic, Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" BorderThickness="1" BorderBrush="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CapsuleAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

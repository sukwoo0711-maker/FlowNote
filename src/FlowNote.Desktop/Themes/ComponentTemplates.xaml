<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:FlowNote.Desktop.Controls">
    <DataTemplate x:Key="TimelineEntryCardTemplate">
        <controls:TimelineEntryCard/>
    </DataTemplate>
    <DataTemplate x:Key="TimelineEventRowTemplate">
        <controls:TimelineEventRow/>
    </DataTemplate>
    <DataTemplate x:Key="TimelineGroupTemplate">
        <TextBlock Margin="88,8,0,4" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Title}"/>
    </DataTemplate>
    <controls:TimelineRowTemplateSelector x:Key="TimelineRowSelector"
                                          EntryTemplate="{StaticResource TimelineEntryCardTemplate}"
                                          EventTemplate="{StaticResource TimelineEventRowTemplate}"
                                          GroupTemplate="{StaticResource TimelineGroupTemplate}"/>
</ResourceDictionary>
